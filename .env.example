# Runtime model for the investigator (free tier is enough; see README "Models")
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Hindsight (long-term memory). Self-host with scripts/hindsight_local.sh, or point at Hindsight Cloud.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
# Extraction model used by the self-hosted server (Groq by default)
HINDSIGHT_LLM_MODEL=gemini-3.1-flash-lite
