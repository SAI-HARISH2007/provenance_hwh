# Runtime model for the investigator (free tier is enough; see README "Models")
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Hindsight (long-term memory). Self-host with `docker compose up -d hindsight`, or point at Hindsight Cloud.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
# Extraction model used by the self-hosted server (Gemini by default; Groq's free quota runs out)
HINDSIGHT_LLM_MODEL=gemini-3.1-flash-lite
# Ignore recalled incidents older than N days (0 = no limit)
HINDSIGHT_MAX_AGE_DAYS=0
# Drop recalled hits below Hindsight's final relevance score (0.1 lets weak look-alikes in)
HINDSIGHT_MIN_SCORE=0.3
# How many past incidents are shown to the agent in one brief (facts per incident are capped at 3)
HINDSIGHT_MAX_INCIDENTS=3

# Reproducibility knobs (all optional; the defaults are what produced the README's numbers)
# Path to the env file loaded at import time (use a second file to keep keys out of the repo)
DOTENV_PATH=.env
# Where the content-addressed LLM response cache lives; committed to the repo, so keep it
LLM_CACHE_DIR=llm_cache
# Set to 1 to forbid network LLM calls and fail on a cache miss (`make eval-replay`)
LLM_REPLAY_ONLY=
